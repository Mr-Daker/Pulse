{
  "functions": [
    {
      "source": "pulse-backend",
      "codebase": "pulse-backend",
      "runtime": "python311",
      "ignore": [
        ".venv",
        "venv",
        "__pycache__",
        "*.pyc",
        ".env"
      ]
    }
  ],
  "hosting": {
    "public": "pulse-frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
